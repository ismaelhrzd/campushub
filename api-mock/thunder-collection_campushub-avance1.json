{
  "info": {
    "name": "CampusHub - Avance 1",
    "description": "Colección de pruebas del API simulado (json-server, http://localhost:3000). Se importa en Thunder Client o Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET /laboratorios",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/laboratorios", "host": ["{{baseUrl}}"], "path": ["laboratorios"] } }
    },
    {
      "name": "GET /laboratorios?sede=Lima Centro",
